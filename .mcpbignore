# Files excluded from the packed .mcpb Claude Desktop Extension bundle.
# `mcpb pack` respects this like .npmignore.
#
# KEPT at runtime (do NOT add here): manifest.json, dist/, node_modules/,
# icon.png, package.json, README.md, LICENSE.
.git/
.github/
.gitignore
.gitattributes
.mcpbignore
src/
scripts/
docs/
*.ts
tsconfig.json
package-lock.json
server.json
llms.txt
CONTRIBUTING.md
dist-mcpb/
# Repository-governance and packaging files: meaningful on GitHub, noise inside
# a user's extension bundle. funding.json in particular would ship a
# fundraising manifest with the maintainer's email to every installed copy,
# which is not what a directory reviewer expects to find in the artefact.
CODE_OF_CONDUCT.md
funding.json
CHANGELOG.md
Dockerfile
.dockerignore
glama.json
tsconfig.test.json
*.mcpb
