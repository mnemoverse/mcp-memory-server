{
  "name": "@mnemoverse/mcp-memory-server",
  "version": "0.10.2",
  "description": "Hosted AI agent memory over MCP that learns from outcomes — feedback re-ranks recall — with shared rooms for multi-agent work; one key or OAuth across Claude Code, Cursor, VS Code & ChatGPT, no infra to run",
  "type": "module",
  "bin": {
    "mcp-memory-server": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./shared": {
      "types": "./dist/shared.d.ts",
      "default": "./dist/shared.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "generate:configs": "node scripts/generate-configs.mjs",
    "verify:configs": "node scripts/generate-configs.mjs --check",
    "check:release-sync": "node scripts/check-release-sync.mjs",
    "limits:refresh": "node scripts/generate-limits.mjs",
    "limits:check": "node scripts/generate-limits.mjs --check",
    "install-hooks": "node scripts/install-hooks.mjs",
    "prebuild": "npm run generate:configs",
    "prepublishOnly": "npm run build",
    "mcpb:validate": "npx -y @anthropic-ai/mcpb@2 validate .",
    "mcpb:pack": "npm run build && npx -y @anthropic-ai/mcpb@2 pack . dist-mcpb/mnemoverse-memory.mcpb"
  },
  "mcpName": "io.github.mnemoverse/mcp-memory-server",
  "keywords": [
    "mcp",
    "memory",
    "ai",
    "ai-agent",
    "claude",
    "cursor",
    "vscode",
    "chatgpt",
    "mnemoverse",
    "persistent-memory",
    "shared-memory",
    "cross-tool",
    "model-context-protocol",
    "hosted-memory",
    "vendor-neutral",
    "mcp-server",
    "long-term-memory",
    "agent-memory",
    "claude-code",
    "memory-rooms"
  ],
  "author": "Mnemoverse <hello@mnemoverse.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/izgorodin",
  "repository": {
    "type": "git",
    "url": "https://github.com/mnemoverse/mcp-memory-server"
  },
  "homepage": "https://mnemoverse.com/docs/api/mcp-server",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=18"
  }
}
